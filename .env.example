# =============================================================================
# eBikes Routing Service - Environment Example
# =============================================================================
# Copy this file to `.env` and fill in values for local development.
# DO NOT commit `.env` with real secrets.

# =============================================================================
# Spring profile
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Server
# =============================================================================
SERVER_PORT=8093
MANAGEMENT_SERVER_PORT=9093

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ebikes_routing
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-db-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# =============================================================================
# RabbitMQ
# =============================================================================
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=<your-rabbitmq-password>

# =============================================================================
# Keycloak (OAuth2 Resource Server)
# =============================================================================
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8080/realms/ebikes
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8080/realms/ebikes/protocol/openid-connect/certs

# =============================================================================
# Routing (Valhalla + fallback config)
# =============================================================================
ROUTING_VALHALLA_BASE_URL=http://localhost:8002
ROUTING_VALHALLA_TIMEOUT_SECONDS=5
ROUTING_MATRIX_MAX_AGENTS=25
ROUTING_FALLBACK_AVERAGE_SPEED_KMH_BICYCLE=15
ROUTING_FALLBACK_AVERAGE_SPEED_KMH_AUTO=30

# =============================================================================
# Pricing
# =============================================================================
PRICING_PREVIEW_EXPIRY_MINUTES=15
PRICING_ZONE_ID=Africa/Nairobi
